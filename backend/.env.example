# Configuration for the GL Portal backend.
# Copy to .env and adjust as needed. AWS credentials are read from the ambient
# environment / credential chain (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, etc.).

# Claude Sonnet cross-region inference profile (the "us." prefix is required for Sonnet 4.x).
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Region where the Bedrock model access is enabled.
AWS_REGION=us-east-1

# If collateral image shows more distinct ornaments than this, the agent suggests splitting.
MAX_ORNAMENTS_PER_IMAGE=12

# Allowed CORS origins (comma-separated). The Next.js apps proxy /api/* same-origin, so this
# only matters when the API is called directly from a browser.
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001

# Seconds to wait for the model to polish a chat message before using the built-in wording.
GUIDANCE_TIMEOUT_S=8

# Signs the staff session cookie. Generate one per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs every assessor out.
AUTH_SECRET=change-me
# How long a sign-in lasts, in seconds (12 hours).
AUTH_TTL_S=43200

# Local PostgreSQL connection (SQLAlchemy + psycopg v3). Create the DB with: createdb gl_portal
DATABASE_URL=postgresql+psycopg://ajay@localhost:5432/gl_portal

# CaratMeter (XRF karat analyser + balance). "mock" simulates the device in-process; "http" calls a
# real branch gateway with the same JSON contract (see README → CaratMeter contract).
CARATMETER_MODE=mock
CARATMETER_BASE_URL=http://localhost:9100
CARATMETER_API_KEY=
CARATMETER_TIMEOUT_S=30
